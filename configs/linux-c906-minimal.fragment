# Documentation for the options enforced by scripts/build-linux.sh.
# The generated, dependency-resolved .config is stored under output/linux/.
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_ISA_C=y
CONFIG_FPU=y
CONFIG_ERRATA_THEAD=y
CONFIG_ERRATA_THEAD_MAE=y
# CONFIG_ERRATA_THEAD_CMO is not set
CONFIG_RISCV_INTC=y
CONFIG_RISCV_TIMER=y
CONFIG_SIFIVE_PLIC=y
CONFIG_TTY=y
# trim profile (default); baseline restores the previous tinyconfig-derived setup.
# CONFIG_VT is not set
# CONFIG_LEGACY_PTYS is not set
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_PRINTK=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
# CONFIG_SMP is not set
# CONFIG_MODULES is not set
